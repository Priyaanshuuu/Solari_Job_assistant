# LiveKit (Voice Agent Hosting & WebRTC)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LLM and speech services
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4-turbo

# Solari (Browser + Sandbox)
SOLARI_API_KEY=your_solari_api_key
SOLARI_API_URL=https://api.getsolari.com

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Agent settings
AGENT_LOG_LEVEL=debug
AGENT_PORT=8081

# Web settings
WEB_PORT=3000
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud

# Profile and resume paths
PROFILE_YAML_PATH=./profile.yaml
RESUME_YAML_PATH=./resume.yaml

# Sandbox Python scripts
SANDBOX_FILTER_SCRIPT_PATH=./sandbox-scripts/filter_and_score.py
SANDBOX_RENDER_SCRIPT_PATH=./sandbox-scripts/render_resume.py

# Optional observability
SENTRY_DSN=
DATADOG_API_KEY=
